    "sync:models": "node scripts/sync-catalog.mjs",
    "prebuild": "node scripts/gen-seo-assets.mjs && node scripts/sync-catalog.mjs",
    "sync:catalog": "node scripts/sync-catalog.mjs",
    "gen:seo": "node scripts/gen-seo-assets.mjs"
  },
  "dependencies": {
