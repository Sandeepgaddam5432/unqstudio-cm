    "diff": "^9.0.0",
    "esbuild-wasm": "^0.28.2",
    "idb": "^8.0.4",
    "jszip": "^3.10.2",
    "lucide-react": "^1.80.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^6.0.3",
    "zustand": "^5.1.0"
