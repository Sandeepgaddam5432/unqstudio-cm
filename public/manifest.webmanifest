{
  "name": "UnQStudio — AI Coding Studio",
  "short_name": "UnQStudio",
  "description": "Free, browser-native AI coding studio. Describe an app, bring your own model key, watch it build live.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "id": "./",
  "display_override": ["standalone", "minimal-ui"],
  "shortcuts": [{ "name": "New project", "short_name": "New", "url": "./#/" }],
  "background_color": "#09090B",
  "theme_color": "#09090B",
  "categories": ["developer", "productivity", "utilities"],
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "favicon.svg", "sizes": "any", "type": "image/svg+xml" }
  ]
}
